[resource]
script = ExtResource("1")
id = &"helena"
display_name = "Helena"
profession = "Comerciante"
sprite = ExtResource("2")
schedule = PackedStringArray("06:00 casa_azul!", "07:30 mercearia_balcao", "18:00 praca_banco_1", "20:00 casa_azul!")
schedule_sunday = PackedStringArray("06:00 casa_azul!", "08:00 igreja_porta", "11:00 praca_2", "17:00 casa_azul!")
gifts_love = PackedStringArray("pequi", "canjica", "abobora")
gifts_like = PackedStringArray("milho", "feijao", "ovo")
gifts_hate = PackedStringArray("fragmento_silencio", "pedra")
festival_marker = &"festa_1"
intro = PackedStringArray("Opa! Você que é da família lá da Fazenda do Pequi? A vila inteira tá comentando.", "Eu sou a Helena, cuido da mercearia. Semente, mantimento... e compro o que você colher, viu?", "Abro de segunda a sábado, das sete e meia às seis. Domingo é dia de missa e descanso.")
lines_morning = PackedStringArray("Bom dia! Chegou mercadoria nova cedinho.", "Café passado agora, se quiser um golinho.")
lines_afternoon = PackedStringArray("Tarde boa pra fazer as contas... e pra vender, hein?")
lines_evening = PackedStringArray("Já fechei o caixa. Amanhã cedo eu tô de volta.")
lines_rain = PackedStringArray("Com essa chuva o povo some da rua. Melhor pra roça, pior pro meu caixa!", "Chuva boa dessas, semente de milho vende que nem água.")
lines_dry = PackedStringArray("Na seca o milho não vinga, mas feijão e mandioca aguentam firme.")
lines_friend = PackedStringArray("Separei umas sementes boas pra você. Freguês de confiança é outra coisa.", "Sabia que seu avô pagava tudo em pequi? Nunca vi ninguém gostar tanto daquele fruto.")
lines_generic = PackedStringArray("Quem planta na hora certa colhe sem aperto.", "Tem dia que eu esqueço o preço de coisa que vendo há vinte anos... esquisito, né?", "Abóbora boa pode trazer. A Dona Alzira compra tudo de mim.")
lines_repeat = PackedStringArray("Mais alguma coisa?", "Volta sempre!")
shop_marker = &"mercearia_balcao"
shop_title = "Mercearia da Helena"
shop_sells = PackedStringArray("semente_milho", "semente_feijao", "semente_abobora", "semente_mandioca", "arroz", "acucar")
shop_buys = PackedInt32Array(2, 3, 6)
