[resource]
script = ExtResource("1")
id = &"toninho"
display_name = "Toninho"
profession = "Ferreiro"
sprite = ExtResource("2")
schedule = PackedStringArray("06:00 ferreiro_porta!", "07:00 ferreiro_bigorna", "12:00 bar_porta", "13:00 ferreiro_bigorna", "19:00 praca_1", "21:00 ferreiro_porta!")
schedule_sunday = PackedStringArray()
intro = PackedStringArray("E aí! Toninho, ferreiro. Se quebrou, eu conserto. Se não quebrou, eu dou um jeito de melhorar.", "A forja tá acesa: faço facão, espada, machado, lança, martelo e arco. Com o tanto de bicho esquisito na mata de noite, é bom andar prevenido.")
lines_morning = PackedStringArray("Forja acesa desde as seis. Ferro bom é ferro quente.")
lines_afternoon = PackedStringArray("Calor da forja mais calor de Goiás... haja água!")
lines_evening = PackedStringArray("Martelo descansando. Amanhã tem mais.")
lines_rain = PackedStringArray("Chuva esfria a oficina. Até que é bom.")
lines_dry = PackedStringArray("Na seca chega muito facão pra afiar. O povo vai pro mato buscar lenha.")
lines_friend = PackedStringArray("Tô desenhando um regador maior pra você. Ainda não tá pronto, mas vai ficar bão demais.")
lines_generic = PackedStringArray("Sabia que tinha uma mina na Serra do Cristal? Diz que o minério de lá é diferente.", "Enxada boa é igual amigo: dura a vida inteira se você cuidar.")
lines_repeat = PackedStringArray("Opa, de novo? Tá precisando de quê?", "Volta outra hora que tô no meio dum serviço.")
shop_marker = &"ferreiro_bigorna"
shop_title = "Ferraria do Toninho"
shop_sells = PackedStringArray("facao", "espada", "machado", "lanca", "martelo", "arco", "flecha")
