[gd_scene load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/core/main.gd" id="scr"]
[ext_resource type="PackedScene" path="res://scenes/farm/farm.tscn" id="farm"]
[ext_resource type="PackedScene" path="res://scenes/interface/hud.tscn" id="hud"]
[ext_resource type="PackedScene" path="res://scenes/interface/touch_controls.tscn" id="touch"]
[ext_resource type="Script" path="res://scripts/interface/inventory_ui.gd" id="inv"]
[ext_resource type="Script" path="res://scripts/weather/weather_fx.gd" id="wfx"]
[ext_resource type="PackedScene" path="res://scenes/vila/vila.tscn" id="vila"]
[ext_resource type="Script" path="res://scripts/interface/dialogue_ui.gd" id="dlg"]
[ext_resource type="Script" path="res://scripts/interface/shop_ui.gd" id="shop"]

[node name="Main" type="Node2D" groups=["save_root"]]
script = ExtResource("scr")

[node name="Farm" parent="." instance=ExtResource("farm")]

[node name="Vila" parent="." instance=ExtResource("vila")]

[node name="WeatherFX" type="Node" parent="."]
script = ExtResource("wfx")

[node name="HUD" parent="." instance=ExtResource("hud")]

[node name="TouchControls" parent="." instance=ExtResource("touch")]

[node name="InventoryUI" type="CanvasLayer" parent="."]
script = ExtResource("inv")

[node name="DialogueUI" type="CanvasLayer" parent="."]
script = ExtResource("dlg")

[node name="ShopUI" type="CanvasLayer" parent="."]
script = ExtResource("shop")
